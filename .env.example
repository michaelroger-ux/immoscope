# Clé API Claude : analyse des photos et compréhension des requêtes (facultatif pour essayer la démo)
ANTHROPIC_API_KEY=

# Modèle et réglages de l'analyse des photos
IMMO_CLAUDE_MODEL=claude-opus-5-5
IMMO_VISION_EFFORT=medium
IMMO_PARSER_EFFORT=low
IMMO_VISION_MAX_IMAGES=8
IMMO_VISION_MAX_SIDE=1280

# Mot de passe d'accès (obligatoire dès que l'application est en ligne)
IMMO_PASSWORD=

# Base PostgreSQL (Supabase : chaîne « Session pooler ») ; sinon fichier SQLite dans IMMO_DATA_DIR
DATABASE_URL=
IMMO_DATA_DIR=data

# Services cartographiques (par défaut : serveurs publics, à ménager)
# IMMO_OVERPASS_URL=https://overpass-api.de/api/interpreter
# IMMO_GEOCODER_FR_URL=https://data.geopf.fr/geocodage/search
